# 必填：JWT 签名密钥（用 openssl rand -hex 32 生成）
JWT_SECRET=please-generate-with-openssl-rand-hex-32

# 可选
PORT=3000
# Prisma resolves SQLite paths relative to schema.prisma (server/prisma/),
# so ../../data points to project_root/data/ to match production layout (where Docker mounts ../data:/data).
DATABASE_URL=file:../../data/salary.db
TZ=Asia/Shanghai