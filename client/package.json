{
  "name": "trae-salary-client",
  "version": "1.0.0",
  "private": true,
  "description": "Taro多端演示项目",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "build:android": "npm run build:h5 && cap sync android",
    "dev:android": "npm run build:android && cap open android",
    "android:assemble": "cd android && ./gradlew assembleDebug",
    "android:apk": "npm run build:android && npm run android:assemble",
    "android:install": "cd android && ./gradlew installDebug",
    "lint": "npm run lint:css:strict-value",
    "lint:css": "stylelint 'src/**/*.scss'",
    "lint:css:strict-value": "stylelint --config .stylelintrc.strict-value.yml 'src/**/*.scss'",
    "lint:css:full": "stylelint --config .stylelintrc.yml 'src/**/*.scss'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run test/ && node --test test/cnHolidayCore.test.mjs test/build/ajv-resolution.test.mjs",
    "test:css": "vitest run test/styles/",
    "test:store": "vitest run test/store/"
  },
  "overrides": {
    "enhanced-resolve": "5.16.0"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@tarojs/components": "4.2.0",
    "@tarojs/helper": "4.2.0",
    "@tarojs/plugin-framework-react": "4.2.0",
    "@tarojs/plugin-platform-h5": "4.2.0",
    "@tarojs/react": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/shared": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "webpack-virtual-modules": "^0.4.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.24.1",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.24.3",
    "@babel/preset-env": "^7.24.4",
    "@babel/preset-react": "^7.24.1",
    "@babel/preset-typescript": "^7.24.1",
    "@capacitor/cli": "^8.5.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "@tarojs/cli": "4.2.0",
    "@tarojs/webpack5-runner": "4.2.0",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.18.4",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "@vitest/snapshot": "^2.1.9",
    "@vitest/ui": "^2.0.5",
    "babel-preset-taro": "4.2.0",
    "css-loader": "7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.2.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.38",
    "react-refresh": "^0.14.2",
    "sass": "^1.75.0",
    "sass-embedded": "^1.100.0",
    "sass-loader": "14.2.1",
    "style-loader": "4.0.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "stylelint-scss": "^7.2.0",
    "typescript": "^5.4.5",
    "vitest": "^2.0.5",
    "webpack": "^5.91.0"
  }
}
