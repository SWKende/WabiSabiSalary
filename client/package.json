{
  "name": "trae-salary-client",
  "version": "1.0.0",
  "private": true,
  "description": "Taro多端演示项目",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
